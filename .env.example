# Base de dados (Neon PostgreSQL) — cria uma gratuita em https://neon.tech
DATABASE_URL="postgresql://user:password@host/luxury_hair?sslmode=require"

# JWT — gera uma string longa e aleatória, ex: `openssl rand -base64 48`
JWT_SECRET="chave-secreta-muito-longa-e-aleatoria"

# Multibanco (referência de testes, gerador simulado, usado sem conta ifthenpay)
MULTIBANCO_ENTIDADE="11111"

# ifthenpay (https://ifthenpay.com) — pagamentos reais. Sem estas variáveis,
# o site continua a funcionar com o gerador Multibanco simulado e o MB WAY
# a auto-confirmar-se, como até aqui.
# Entidade + Sub-Entidade Multibanco, atribuídas no backoffice da ifthenpay
# ao criar um serviço "Multibanco" (referência gerada localmente, sem API).
IFTHENPAY_MB_ENTITY=""
IFTHENPAY_MB_SUBENTITY=""
# Chave do serviço "MB WAY" no backoffice da ifthenpay.
IFTHENPAY_MBWAY_KEY=""
# "Anti-phishing key" definida no backoffice da ifthenpay, usada para
# validar que o callback de confirmação de pagamento é mesmo deles.
IFTHENPAY_ANTI_PHISHING_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
