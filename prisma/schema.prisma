// Luxury Hair Portugal — schema da base de dados (Prisma + PostgreSQL/Neon).
// Depois de definir DATABASE_URL no .env, corre `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  ADMIN
}

enum OrderStatus {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum PaymentStatus {
  PENDENTE
  PAGO
  EXPIRADO
}

model User {
  id        String     @id @default(cuid())
  nome      String
  email     String     @unique
  password  String
  telefone  String?
  morada    String?
  cidade    String?
  pais      String     @default("PT")
  role      Role       @default(CLIENTE)
  createdAt DateTime   @default(now())
  orders    Order[]
  cart      Cart[]
  wishlist  Wishlist[]
}

model Category {
  id       String    @id @default(cuid())
  nome     String
  slug     String    @unique
  imagem   String?
  products Product[]
}

model Product {
  id               String      @id @default(cuid())
  nome             String
  slug             String      @unique
  resumo           String      @default("")
  descricao        String
  cuidados         String      @default("")
  envio            String      @default("Envio em 24-48h para Portugal Continental. Entrega em 3-10 dias úteis para Ilhas e Moçambique.")
  preco            Float
  precoPromocional Float?
  stock            Int         @default(0)
  categoriaId      String
  categoria        Category    @relation(fields: [categoriaId], references: [id])
  imagemPrincipal  String? // sem foto real ainda -> frontend gera um placeholder a partir do slug
  imagens          String[]
  cores            String[]
  comprimentos     String[]
  densidades       String[]
  texturas         String[]
  badge            String? // "Novo" | "Mais Vendido" — "Esgotado" é sempre derivado do stock, nunca guardado
  bestseller       Boolean     @default(false)
  destaque         Boolean     @default(false)
  ativo            Boolean     @default(true)
  createdAt        DateTime    @default(now())
  cartItems        Cart[]
  wishlistItems    Wishlist[]
  orderItems       OrderItem[]
  reviews          Review[]

  @@index([categoriaId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  autor      String
  rating     Int
  comentario String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Cart {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  productId  String
  variante   String   @default("")
  quantidade Int      @default(1)
  product    Product  @relation(fields: [productId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id           String          @id @default(cuid())
  userId       String?
  nomeCliente  String
  email        String
  telefone     String
  morada       String
  cidade       String
  codigoPostal String
  pais         String
  subtotal     Float
  desconto     Float           @default(0)
  envio        Float           @default(0)
  total        Float
  estado       OrderStatus     @default(PENDENTE)
  user         User?           @relation(fields: [userId], references: [id])
  items        OrderItem[]
  payment      Payment?
  tracking     OrderTracking[]
  createdAt    DateTime        @default(now())

  @@index([userId])
  @@index([email])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  nomeProduto   String
  variante      String  @default("")
  precoUnitario Float
  quantidade    Int
  order         Order   @relation(fields: [orderId], references: [id])
  product       Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique
  metodo     String        @default("multibanco")
  entidade   String
  referencia String
  valor      Float
  estado     PaymentStatus @default(PENDENTE)
  expiraEm   DateTime
  order      Order         @relation(fields: [orderId], references: [id])
  createdAt  DateTime      @default(now())
}

model OrderTracking {
  id        String   @id @default(cuid())
  orderId   String
  estado    String
  descricao String
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId])
}
